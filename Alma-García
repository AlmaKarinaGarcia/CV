<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>CV – Alma G. | Marketing Digital & Performance</title>
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;700;900&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
  :root {
    --ink: #0f0f0f;
    --accent: #c8452a;
    --accent2: #e8a87c;
    --bg: #faf8f4;
    --sidebar: #1a1a1a;
    --sidebar-text: #e8e2d6;
    --muted: #6b6560;
    --rule: #d9d4cb;
    --tag-bg: #f0ece4;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'DM Sans', sans-serif;
    background: #e8e2d6;
    display: flex;
    justify-content: center;
    align-items: flex-start;
    min-height: 100vh;
    padding: 32px 16px;
    color: var(--ink);
  }

  .page {
    width: 900px;
    background: var(--bg);
    display: grid;
    grid-template-columns: 280px 1fr;
    box-shadow: 0 20px 60px rgba(0,0,0,0.25);
    position: relative;
  }

  /* ── SIDEBAR ── */
  .sidebar {
    background: var(--sidebar);
    color: var(--sidebar-text);
    padding: 48px 28px;
    position: relative;
    overflow: hidden;
  }

  .sidebar::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 200px; height: 200px;
    border-radius: 50%;
    border: 40px solid rgba(200,69,42,0.12);
  }
  .sidebar::after {
    content: '';
    position: absolute;
    bottom: 40px; left: -80px;
    width: 220px; height: 220px;
    border-radius: 50%;
    border: 50px solid rgba(232,168,124,0.08);
  }

  .avatar-wrap {
    width: 100px; height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--accent2));
    display: flex; align-items: center; justify-content: center;
    font-family: 'Playfair Display', serif;
    font-size: 38px;
    font-weight: 900;
    color: #fff;
    margin-bottom: 22px;
    letter-spacing: -1px;
  }

  .s-section {
    margin-bottom: 32px;
    position: relative;
    z-index: 1;
  }

  .s-label {
    font-size: 9px;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--accent2);
    font-weight: 600;
    margin-bottom: 12px;
    display: block;
  }

  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 8px;
    margin-bottom: 8px;
    font-size: 12.5px;
    color: #c8c2b8;
    line-height: 1.4;
  }

  .contact-icon {
    width: 16px;
    flex-shrink: 0;
    opacity: 0.6;
    margin-top: 1px;
  }

  .skill-item {
    margin-bottom: 10px;
  }

  .skill-name {
    font-size: 12px;
    color: var(--sidebar-text);
    margin-bottom: 4px;
    font-weight: 500;
  }

  .skill-bar {
    height: 3px;
    background: rgba(255,255,255,0.1);
    border-radius: 2px;
    overflow: hidden;
  }

  .skill-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--accent), var(--accent2));
    border-radius: 2px;
  }

  .tool-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tool-tag {
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
    color: #c8c2b8;
    font-size: 10.5px;
    padding: 4px 9px;
    border-radius: 2px;
    font-weight: 400;
  }

  .edu-item {
    margin-bottom: 14px;
  }

  .edu-title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--sidebar-text);
    line-height: 1.3;
  }

  .edu-sub {
    font-size: 11.5px;
    color: #8a847c;
    margin-top: 2px;
  }

  /* ── MAIN ── */
  .main {
    padding: 52px 44px 48px;
  }

  .header-block {
    margin-bottom: 36px;
    padding-bottom: 28px;
    border-bottom: 1.5px solid var(--rule);
  }

  .name {
    font-family: 'Playfair Display', serif;
    font-size: 46px;
    font-weight: 900;
    line-height: 1;
    letter-spacing: -1.5px;
    color: var(--ink);
  }

  .name span {
    color: var(--accent);
  }

  .title-line {
    font-size: 12.5px;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--muted);
    font-weight: 500;
    margin-top: 8px;
  }

  .summary {
    margin-top: 16px;
    font-size: 13px;
    color: #444;
    line-height: 1.75;
    max-width: 480px;
  }

  .section {
    margin-bottom: 30px;
  }

  .section-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .section-title {
    font-family: 'Playfair Display', serif;
    font-size: 18px;
    font-weight: 700;
    color: var(--ink);
    white-space: nowrap;
  }

  .section-line {
    flex: 1;
    height: 1px;
    background: var(--rule);
  }

  .exp-item {
    display: grid;
    grid-template-columns: 3px 1fr;
    gap: 0 18px;
    margin-bottom: 24px;
    position: relative;
  }

  .exp-dot {
    width: 3px;
    background: linear-gradient(180deg, var(--accent) 0%, transparent 100%);
    border-radius: 3px;
    position: relative;
  }

  .exp-dot::before {
    content: '';
    position: absolute;
    top: 3px; left: -4px;
    width: 11px; height: 11px;
    border-radius: 50%;
    background: var(--accent);
    border: 2px solid var(--bg);
    box-shadow: 0 0 0 1.5px var(--accent);
  }

  .exp-content {}

  .exp-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 2px;
  }

  .exp-role {
    font-size: 14px;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.3;
  }

  .exp-period {
    font-size: 10.5px;
    color: var(--muted);
    white-space: nowrap;
    margin-left: 12px;
    padding: 2px 8px;
    background: var(--tag-bg);
    border-radius: 2px;
    flex-shrink: 0;
  }

  .exp-company {
    font-size: 12px;
    color: var(--accent);
    font-weight: 500;
    margin-bottom: 8px;
  }

  .exp-bullets {
    list-style: none;
    padding: 0;
  }

  .exp-bullets li {
    font-size: 12.5px;
    color: #484440;
    line-height: 1.65;
    padding-left: 14px;
    position: relative;
    margin-bottom: 3px;
  }

  .exp-bullets li::before {
    content: '—';
    position: absolute;
    left: 0;
    color: var(--accent2);
    font-weight: 700;
  }

  .kpi-row {
    display: flex;
    gap: 14px;
    flex-wrap: wrap;
    margin-top: 10px;
  }

  .kpi-tag {
    background: var(--tag-bg);
    border: 1px solid var(--rule);
    font-size: 10.5px;
    padding: 3px 10px;
    border-radius: 2px;
    color: var(--muted);
    font-weight: 500;
  }

  @media print {
    body { padding: 0; background: white; }
    .page { box-shadow: none; }
  }
</style>
</head>
